# Copy to .env.local for local development and add the same keys in Vercel → Project → Settings → Environment Variables.
# Setup steps for every value: docs/concierge-setup.md

# Public URL of the site (Stripe redirects back here after payment)
SITE_URL=https://atillabarbarossa.com

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Meta app (developers.facebook.com → your app)
META_APP_SECRET=
# Any random string; paste the same value in the webhook settings of the Meta app
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# WhatsApp Cloud API (WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# Instagram API with Instagram Login (Instagram → API setup)
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Only if Instagram lives in a different Meta app than WhatsApp
INSTAGRAM_APP_SECRET=
# Words under a post/reel that trigger an automatic DM
IG_COMMENT_KEYWORDS=tur,tour,reise,info,preis,price,fiyat

# Atilla's personal WhatsApp number, E.164 without "+", e.g. 4915112345678
STAFF_WHATSAPP=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Timezone the tours run in
TOUR_TIMEZONE=Europe/Istanbul
