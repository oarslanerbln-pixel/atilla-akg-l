# Mail delivery for the contact form (src/app/api/contact/route.ts).
# Without all three the endpoint answers 503 and the form shows the direct
# mail address instead — it never pretends a message was sent.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend, otherwise the
# provider rejects the message.
CONTACT_FROM_EMAIL=
