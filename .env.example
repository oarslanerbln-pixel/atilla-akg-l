# Copy to .env.local for local development and add the same keys in Vercel → Project → Settings → Environment Variables.
# Setup steps for every value: docs/concierge-setup.md

# Public URL of the site (Stripe redirects back here after payment)
SITE_URL=https://atillabarbarossa.com

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=

# Supabase (Project Settings → API). The service role key is secret: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption of customer data at rest (names, numbers, emails, conversations).
# Generate each key with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: if these keys are lost, the stored customer data cannot be read.
# Format "<id>:<key>"; the first key encrypts, all listed keys decrypt. Rotate by prepending "2:<new key>,".
CONCIERGE_ENCRYPTION_KEYS=1:
# Separate key for the searchable fingerprint of phone numbers / Instagram ids. Never rotate it.
CONCIERGE_INDEX_KEY=

# Meta app (developers.facebook.com → your app)
META_APP_SECRET=
# Any random string; paste the same value in the webhook settings of the Meta app
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# WhatsApp Cloud API (WhatsApp → API Setup)
WHATSAPP_PHONE_NUMBER_ID=
# Permanent System User token with whatsapp_business_messaging
WHATSAPP_ACCESS_TOKEN=

# Instagram API with Instagram Login (Instagram → API setup)
# Long-lived token (60 days). It only seeds the copy stored in Supabase, which the weekly cron
# below renews. Paste a new token here (and redeploy) to replace the stored one.
INSTAGRAM_ACCESS_TOKEN=
# Only if Instagram lives in a different Meta app than WhatsApp
INSTAGRAM_APP_SECRET=
# Words under a post/reel that trigger an automatic DM
IG_COMMENT_KEYWORDS=tur,tour,reise,info,preis,price,fiyat

# Atilla's personal WhatsApp number, E.164 without "+", e.g. 4915112345678
STAFF_WHATSAPP=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Timezone the tours run in
TOUR_TIMEZONE=Europe/Istanbul

# Vercel Cron (vercel.json) sends this as "Authorization: Bearer <value>"; without it the cron
# endpoints answer 503. The weekly /api/cron/instagram-token renews INSTAGRAM_ACCESS_TOKEN.
# Generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# --- Contact form ---
# Mail delivery for the contact form (src/app/api/contact/route.ts).
# Without all three the endpoint answers 503 and the form shows the direct
# mail address instead — it never pretends a message was sent.

# https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiries are delivered.
CONTACT_TO_EMAIL=

# Sender address. Must be on a domain verified in Resend, otherwise the
# provider rejects the message.
CONTACT_FROM_EMAIL=

# --- Search engines ---
# Optional. The token from Google Search Console ("HTML tag" method) and from
# Bing Webmaster Tools ("Meta tag" method), without the surrounding tag. When
# set, the site prints the matching <meta> tag (src/lib/metadata.ts). Not
# needed if the domain is verified by DNS. Steps: docs/seo-geo.md
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
