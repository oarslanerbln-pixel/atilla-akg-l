# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit credentials; .env.example documents the variables
.env*
!.env.example

# vercel
/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Raw camera masters kept beside the project. hero-video.mp4.mp4 is 128 MB,
# which GitHub rejects outright; the delivery copies under public/ are the
# ones the site ships and they stay tracked. A blanket *.mp4 was excluding
# those too and would have made every future clip need `git add -f`.
/*.mp4.mp4
/hero-video.mp4.mp4

# editor / agent local state
/.vscode
/.agents
